{
  "name": "obsidian-mcp-filesystem",
  "version": "0.1.0",
  "description": "MCP server for Obsidian with filesystem access and content search",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:mutation-pagination": "stryker run --mutate 'src/config.js' --mutate 'src/search.js'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "glob": "^10.3.10"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.2.0",
    "@stryker-mutator/vitest-runner": "^9.2.0",
    "@types/node": "^24.0.3",
    "@vitest/coverage-v8": "^5.0.0",
    "vitest": "^5.0.0"
  }
}
